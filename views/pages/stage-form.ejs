<section class="page-heading"><div><p class="eyebrow">ВИРОБНИЧИЙ ПЛАН</p><h1>Новий етап<span class="heading-dot">.</span></h1><p class="subtitle">Додаткове завдання для замовлення.</p></div></section><section class="panel form-panel"><% if(error){ %><div class="notice error"><%= error %></div><% } %><form method="post" action="/plans/new"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div class="field"><label>Замовлення</label><select name="order_id" required><option value="">Оберіть</option><% orders.forEach(x=>{ %><option value="<%= x.id %>" <%= String(form.order_id)===String(x.id)?'selected':'' %>><%= x.order_number %></option><% }) %></select></div><div class="field"><label>Продукт або напівфабрикат</label><select name="product_id" required><option value="">Оберіть</option><% products.forEach(x=>{ %><option value="<%= x.id %>" <%= String(form.product_id)===String(x.id)?'selected':'' %>><%= x.name %></option><% }) %></select></div><div class="field"><label>Лінія</label><select name="work_center_id" required><option value="">Оберіть</option><% centers.forEach(x=>{ %><option value="<%= x.id %>" <%= String(form.work_center_id)===String(x.id)?'selected':'' %>><%= x.code %> · <%= x.name %></option><% }) %></select></div><div class="field"><label>Кількість</label><input type="number" name="quantity_needed" min="0.001" step="0.001" value="<%= form.quantity_needed||'' %>" required></div><div class="field"><label>Назва етапу</label><input name="stage_name" value="<%= form.stage_name||'' %>"></div></div><div class="form-actions"><a class="button" href="/plans">Скасувати</a><button class="button primary">Додати етап</button></div></form></section>
