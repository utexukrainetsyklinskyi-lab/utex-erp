<section class="page-heading"><div><p class="eyebrow">ВІД КЛІЄНТА ДО ВИРОБНИЦТВА</p><h1>Замовлення<span class="heading-dot">.</span></h1><p class="subtitle">Продукція, терміни й етапи кожного замовлення.</p></div><a class="button primary" href="/orders/new"><svg><use href="#i-plus"/></svg>Нове замовлення</a></section>
<section class="panel"><form class="filters" method="get" action="/orders"><label class="search-field"><svg><use href="#i-search"/></svg><input name="q" value="<%= q %>" placeholder="Номер, клієнт або продукція…"></label><select name="status"><option value="">Усі статуси</option><option value="new" <%= status==='new'?'selected':'' %>>Нове</option><option value="in_work" <%= status==='in_work'?'selected':'' %>>В роботі</option><option value="done" <%= status==='done'?'selected':'' %>>Готове</option></select><select name="client"><option value="">Усі клієнти</option><% clients.forEach(c=>{ %><option value="<%= c.id %>" <%= String(client)===String(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select><select name="fiber_type"><option value="">Усі типи волокна</option><% fiberTypes.forEach(f=>{ %><option value="<%= f.value %>" <%= fiberType===f.value?'selected':'' %>><%= f.value %></option><% }) %></select><% if (typeof query !== 'undefined' && query.overdue==='1') { %><input type="hidden" name="overdue" value="1"><% } %><button class="button">Застосувати</button><a class="text-link muted" href="/orders">Скинути</a></form>
<div class="table-scroll"><table><thead><tr><th>Замовлення / клієнт</th><th>Продукція</th><th>Кількість</th><th>Етапи</th><th>Термін</th><th>Статус</th><% if(user.isSuperuser){ %><th></th><% } %></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td><a class="cell-title" href="/orders/<%= o.id %>"><%= o.order_number %></a><span class="cell-sub"><%= o.client_name %></span></td><td><%= o.product_name %><span class="cell-sub"><%= o.fiber_type || '' %></span></td><td><%= Number(o.quantity).toFixed(2) %> км</td><td><%= o.done_stages || 0 %> / <%= o.total_stages %></td><td class="<%= o.deadline<today && o.status!=='done'?'text-danger':'' %>"><%= new Date(o.deadline+'T00:00:00').toLocaleDateString('uk-UA') %></td><td><span class="badge <%= o.status %>"><%= ({new:'Нове',in_work:'В роботі',done:'Готове'})[o.status] %></span></td><% if(user.isSuperuser){ %><td><form method="post" action="/admin/orders/<%= o.id %>/delete" onsubmit="return confirm('Видалити замовлення та його виробничі завдання?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-link text-danger" type="submit">Видалити</button></form></td><% } %></tr><% }) %><% if(!orders.length){ %><tr><td colspan="<%= user.isSuperuser?7:6 %>"><div class="empty-state"><strong>Замовлень не знайдено</strong><span>Змініть фільтри або додайте перше замовлення.</span></div></td></tr><% } %></tbody></table></div><%- include('../partials/pagination', { page }) %></section>
