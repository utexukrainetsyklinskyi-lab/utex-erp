<section class="page-heading"><div><p class="eyebrow">ПЛАНУВАННЯ ТА КОНТРОЛЬ</p><h1>Виробничий план<span class="heading-dot">.</span></h1><p class="subtitle">Етапи виробництва, терміни та фактичний прогрес.</p></div><div class="actions"><a class="button" href="/gantt"><svg><use href="#i-chart"/></svg>Графік</a><a class="button primary" href="/plans/new"><svg><use href="#i-plus"/></svg>Додати етап</a></div></section>
<section class="panel"><form class="filters" method="get" action="/plans"><label class="search-field"><svg><use href="#i-search"/></svg><input name="q" value="<%= q %>" placeholder="Замовлення, продукт або етап…"></label><select name="status"><option value="active" <%= status==='active'?'selected':'' %>>Активні</option><option value="all" <%= status==='all'?'selected':'' %>>Усі статуси</option><option value="queued" <%= status==='queued'?'selected':'' %>>У черзі</option><option value="scheduled" <%= status==='scheduled'?'selected':'' %>>Заплановано</option><option value="in_progress" <%= status==='in_progress'?'selected':'' %>>Частково виконані</option><option value="completed" <%= status==='completed'?'selected':'' %>>Завершені</option></select><select name="center"><option value="">Усі лінії</option><% centers.forEach(c=>{ %><option value="<%= c.id %>" <%= String(center)===String(c.id)?'selected':'' %>><%= c.code %> · <%= c.name %></option><% }) %></select><select name="fiber_type"><option value="">Усі типи волокна</option><% fiberTypes.forEach(f=>{ %><option value="<%= f.value %>" <%= fiberType===f.value?'selected':'' %>><%= f.value %></option><% }) %></select><select name="item_type"><option value="">Усі типи продукції</option><option value="product" <%= itemType==='product'?'selected':'' %>>Кабель</option><option value="half_product" <%= itemType==='half_product'?'selected':'' %>>Напівфабрикат</option><option value="material" <%= itemType==='material'?'selected':'' %>>Матеріал</option></select><% if (typeof query !== 'undefined' && query.unscheduled==='1') { %><input type="hidden" name="unscheduled" value="1"><% } %><button class="button">Застосувати</button><a class="text-link muted" href="/plans">Скинути</a></form><%- include('../partials/plan-table', { rows: plans }) %><%- include('../partials/pagination', { page }) %></section>
