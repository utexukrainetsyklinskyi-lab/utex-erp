<section class="page-heading"><div><p class="eyebrow">ФАКТИЧНИЙ ВИПУСК</p><h1>Журнал виконання<span class="heading-dot">.</span></h1><p class="subtitle">Звіти операторів, випуск, простої та виробничі відхилення.</p></div><a class="button primary" href="/logs/new"><svg><use href="#i-plus"/></svg>Новий запис</a></section>
<section class="panel">
  <form class="filters" method="get" action="/logs">
    <label class="search-field"><svg><use href="#i-search"/></svg><input name="q" value="<%= q %>" placeholder="Оператор, замовлення, продукт або відхилення…"></label>
    <select name="production_type"><option value="">Усі типи робіт</option><% productionTypes.forEach(x=>{ %><option value="<%= x.value %>" <%= productionType===x.value?'selected':'' %>><%= x.value %></option><% }) %></select>
    <select name="operator"><option value="">Усі оператори</option><% employees.forEach(x=>{ %><option value="<%= x.id %>" <%= String(operator)===String(x.id)?'selected':'' %>><%= x.last_name %> <%= x.first_name %></option><% }) %></select>
    <select name="deviation"><option value="">Відхилення · усі</option><option value="1" <%= deviation==='1'?'selected':'' %>>Є відхилення</option><option value="0" <%= deviation==='0'?'selected':'' %>>Без відхилення</option></select>
    <select name="downtime"><option value="">Простої · усі</option><option value="1" <%= downtime==='1'?'selected':'' %>>Є простій</option><option value="0" <%= downtime==='0'?'selected':'' %>>Без простою</option></select>
    <button class="button" type="submit">Застосувати</button><a class="text-link muted" href="/logs">Скинути</a>
  </form>
  <div class="table-scroll"><table><thead><tr><th>Дата й час</th><th>Завдання</th><th>Випуск</th><th>Тип роботи</th><th>Оператор</th><th>Простій</th><th>Відхилення</th><% if(user.isSuperuser){ %><th></th><% } %></tr></thead><tbody>
    <% logs.forEach(l=>{ %><tr>
      <td><%= new Date(l.date_created).toLocaleString('uk-UA') %></td>
      <td><%= l.order_number || 'Без завдання' %><span class="cell-sub"><%= l.product_name || '' %></span></td>
      <td><%= Number(l.quantity_produced).toFixed(2) %> <%= l.unit || '' %></td>
      <td><%= l.production_type || '—' %></td>
      <td><%= l.last_name %> <%= l.first_name %></td>
      <td><%= l.has_downtime ? `${l.downtime_hours} год ${l.downtime_minutes} хв · ${l.downtime_reason}` : '—' %></td>
      <td><%= l.has_deviation ? l.deviation_comment : '—' %></td>
      <% if(user.isSuperuser){ %><td><form method="post" action="/admin/logs/<%= l.id %>/delete" onsubmit="return confirm('Видалити цей запис виконання?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-link text-danger" type="submit">Видалити</button></form></td><% } %>
    </tr><% }) %>
    <% if(!logs.length){ %><tr><td colspan="<%= user.isSuperuser?8:7 %>"><div class="empty-state"><strong>Записів не знайдено</strong><span>Змініть пошук або фільтри.</span></div></td></tr><% } %>
  </tbody></table></div>
  <%- include('../partials/pagination', { page }) %>
</section>
