<section class="page-heading"><div><p class="eyebrow">КАРТКА ЗАМОВЛЕННЯ</p><h1><%= order.order_number %><span class="heading-dot">.</span></h1><p class="subtitle"><%= order.client_name %> · <%= order.product_name %> · <%= Number(order.quantity).toFixed(2) %> <%= order.unit %></p></div><a class="button" href="/orders">До замовлень</a></section>
<% if (query.saved === '1') { %><div class="notice">Статус замовлення збережено.</div><% } %>
<div class="detail-grid four"><div class="detail-card"><small>Термін виконання</small><strong><%= new Date(order.deadline+'T00:00:00').toLocaleDateString('uk-UA') %></strong></div><div class="detail-card"><small>Тип волокна</small><strong><%= order.fiber_type || '—' %></strong><small><%= order.skip_fiber_painting ? 'Фарбування ОВ: ні' : 'Фарбування ОВ: так' %></small></div><div class="detail-card"><small>Довжина барабана</small><strong><%= order.length_per_drum ? Number(order.length_per_drum).toFixed(2)+' км' : '—' %></strong></div><div class="detail-card"><small>Статус</small><form method="post" action="/orders/<%= order.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><option value="new" <%= order.status==='new'?'selected':'' %>>Нове</option><option value="in_work" <%= order.status==='in_work'?'selected':'' %>>В роботі</option><option value="done" <%= order.status==='done'?'selected':'' %>>Готове</option></select><button class="button compact" type="submit">Зберегти</button></form></div></div>
<section class="panel"><div class="panel-heading"><div><h2>Виробничі етапи</h2><p>Автоматично створені за деревом специфікації</p></div><a class="button compact" href="/plans/new">Додати етап</a></div><%- include('../partials/plan-table', { rows: plans }) %></section>
