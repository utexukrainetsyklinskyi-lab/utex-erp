<section class="page-heading"><div><p class="eyebrow">ДОВІДНИК</p><h1><%= config.title %><span class="heading-dot">.</span></h1><p class="subtitle">Керування довідковими даними системи.</p></div><a class="button primary" href="/directories/<%= key %>/new"><svg><use href="#i-plus"/></svg>Додати</a></section><section class="panel"><form class="filters" method="get" action="/directories/<%= key %>"><label class="search-field"><svg><use href="#i-search"/></svg><input name="q" value="<%= q %>" placeholder="Пошук у <%= config.title.toLowerCase() %>…"></label><% Object.entries(filterOptions).forEach(([name,filter])=>{ %><select name="<%= name %>" aria-label="Фільтр: <%= filter.label %>"><option value=""><%= filter.label %> · усі</option><% filter.choices.forEach(([value,label])=>{ %><option value="<%= value %>" <%= selectedFilters[name]===value?'selected':'' %>><%= label %></option><% }) %></select><% }) %><button class="button" type="submit">Застосувати</button><a class="text-link muted" href="/directories/<%= key %>">Скинути</a></form><div class="table-scroll"><table><thead><tr><% fields.forEach(f=>{ %><th><%= f[1] %></th><% }) %><th></th></tr></thead><tbody><% rows.forEach(row=>{ %><tr><% fields.forEach(f=>{ let v=row[f[0]]; if(f[0]==='product_id') v=row.product_name; if(f[0]==='ingredient_id') v=row.ingredient_name; if(f[0]==='client_id') v=row.client_name; if(f[0]==='work_center_id') v=row.center_code; if(f[2]==='checkbox') v=Number(v)?'Так':'Ні'; %><td><%= v===null||v===undefined||v===''?'—':v %></td><% }) %><td class="nowrap"><a class="text-link" href="/directories/<%= key %>/<%= row.id %>/edit">Змінити</a><form class="inline-form" method="post" action="/directories/<%= key %>/<%= row.id %>/delete" onsubmit="return confirm('Видалити запис?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-link text-danger">Видалити</button></form></td></tr><% }) %><% if(!rows.length){ %><tr><td colspan="<%= fields.length+1 %>"><div class="empty-state"><strong>Записів не знайдено</strong><span>Змініть пошук або фільтри.</span></div></td></tr><% } %></tbody></table></div><%- include('../partials/pagination', { page }) %></section>
