<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> · UTEX ERP</title>
  <script src="/assets/js/workspace-theme.js"></script>
  <link rel="stylesheet" href="/assets/css/workspace.css">
  <link rel="stylesheet" href="/assets/css/workspace-theme.css">
  <link rel="stylesheet" href="/assets/css/app.css">
  <% if (view === 'gantt') { %>
    <link rel="stylesheet" href="/assets/vendor/vis-timeline/vis-timeline-graph2d.min.css">
    <script src="/assets/vendor/vis-timeline/vis-timeline-graph2d.min.js" defer></script>
    <script src="/assets/js/workspace-gantt.js" defer></script>
  <% } %>
  <% if (view === 'log-form') { %><script src="/assets/js/log-form.js" defer></script><% } %>
</head>
<body>
<%- include('partials/icons') %>
<a class="skip-link" href="#main">Перейти до вмісту</a>
<aside class="sidebar">
  <a class="brand" href="/" aria-label="UTEX — головна"><img src="/assets/logo.png" alt="UTEX"><span>PRODUCTION / ERP</span></a>
  <div class="workspace-label"><span class="live-dot"></span> Виробничий простір</div>
  <nav aria-label="Основна навігація">
    <p class="nav-caption">РОБОЧИЙ ПРОСТІР</p>
    <a class="nav-item <%= section==='dashboard'?'active':'' %>" href="/"><svg><use href="#i-grid"/></svg>Огляд виробництва</a>
    <a class="nav-item <%= section==='plans'?'active':'' %>" href="/plans"><svg><use href="#i-layers"/></svg>Виробничий план</a>
    <a class="nav-item <%= section==='gantt'?'active':'' %>" href="/gantt"><svg><use href="#i-chart"/></svg>Графік ліній</a>
    <a class="nav-item <%= section==='orders'?'active':'' %>" href="/orders"><svg><use href="#i-orders"/></svg>Замовлення</a>
    <a class="nav-item <%= section==='logs'?'active':'' %>" href="/logs"><svg><use href="#i-check"/></svg>Журнал виконання</a>
    <p class="nav-caption second">НАЛАШТУВАННЯ РОБОТИ</p>
    <a class="nav-item <%= section==='directories'?'active':'' %>" href="/directories"><svg><use href="#i-box"/></svg>Довідники</a>
    <% if (user.isSuperuser) { %><a class="nav-item <%= section==='admin'?'active':'' %>" href="/admin"><svg><use href="#i-users"/></svg>Адміністрування</a><% } %>
  </nav>
  <div class="sidebar-bottom">
    <div class="sidebar-note"><svg><use href="#i-factory"/></svg><strong>Від замовлення<br>до готового кабелю.</strong><span>UTEX Україна</span></div>
    <div class="user"><span class="avatar"><%= user.username.slice(0,1).toUpperCase() %></span><div><strong><%= user.firstName || user.username %></strong><small>Робочий обліковий запис</small></div>
      <form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="icon-button" title="Вийти" aria-label="Вийти"><svg><use href="#i-exit"/></svg></button></form>
    </div>
  </div>
</aside>
<div class="app">
  <header class="topbar"><div class="breadcrumb">UTEX ERP <span>/</span> <strong><%= title %></strong></div><div class="topbar-right"><span class="date"><svg><use href="#i-calendar"/></svg><%= new Intl.DateTimeFormat('uk-UA',{day:'2-digit',month:'long',year:'numeric'}).format(new Date()) %></span><button type="button" class="button theme-toggle" id="theme-toggle" aria-label="Темна тема" aria-pressed="true"><span class="theme-symbol" aria-hidden="true">◐</span><span id="theme-label">Темна тема</span></button><span class="environment"><span class="live-dot"></span> Виробництво</span></div></header>
  <main id="main"><%- include(`pages/${view}`) %></main>
  <footer class="footer"><span>UTEX · Система управління виробництвом</span><span>Плануйте. Виробляйте. Контролюйте.</span></footer>
</div>
</body></html>
