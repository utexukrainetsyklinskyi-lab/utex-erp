<div class="table-scroll"><table class="admin-plan-table"><thead><tr><th>Замовлення / етап</th><th>Продукція</th><th>Тип волокна</th><th>Конструкція / ОВ</th><th>Необхідно</th><th>Лінія</th><th>Прогрес</th><th>Час, год</th><th>Термін</th><th>Статус</th><th>Дія</th><% if(user.isSuperuser){ %><th></th><% } %></tr></thead><tbody><% rows.forEach(p=>{ const percent=p.quantity_needed>0?Math.min(100,Math.round(p.produced/p.quantity_needed*100)):0; const displayStatus=p.status==='queued'&&p.planned_end?'scheduled':p.status; %><tr><td><a class="cell-title" href="/plans/<%= p.id %>">№<%= p.order_number || '—' %></a><span class="cell-sub"><%= p.stage_name || ('Етап '+p.id) %></span></td><td><%= p.product_name %></td><td><%= p.fiber_type || '—' %></td><td><%= p.structure_sku || '—' %><span class="cell-sub"><%= p.fiber_count ? `${p.fiber_count} ОВ` : '—' %></span></td><td><%= Number(p.quantity_needed).toFixed(3) %> <%= p.unit %><span class="cell-sub">Факт: <%= Number(p.produced || 0).toFixed(3) %> <%= p.unit %></span></td><td><%= p.center_code || 'Не призначена' %></td><td><div class="progress"><span style="width:<%= percent %>%"></span></div><small><%= percent %>%</small></td><td><%= Number(p.duration_hours||0).toFixed(2) %></td><td class="<%= p.deadline && p.deadline < today && p.status!=='completed'?'text-danger':'' %>"><%= p.deadline ? new Date(p.deadline+'T00:00:00').toLocaleDateString('uk-UA') : '—' %></td><td><span class="badge <%= displayStatus %>"><%= ({queued:'У черзі',scheduled:'Заплановано',in_progress:'Частково виконано',completed:'Завершено'})[displayStatus] || displayStatus %></span></td><td><a class="button compact" href="/logs/new?plan=<%= p.id %>&amp;quantity=<%= p.quantity_needed %>">На підставі</a></td><% if(user.isSuperuser){ %><td><form method="post" action="/admin/plans/<%= p.id %>/delete" onsubmit="return confirm('Видалити завдання? Пов’язані записи виконання залишаться без завдання.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-link text-danger" type="submit">Видалити</button></form></td><% } %></tr><% }) %><% if(!rows.length){ %><tr><td colspan="<%= user.isSuperuser?12:11 %>"><div class="empty-state">Поки немає виробничих завдань.</div></td></tr><% } %></tbody></table></div>
