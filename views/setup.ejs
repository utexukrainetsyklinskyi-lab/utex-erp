<!doctype html><html lang="uk"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/assets/css/workspace.css"><link rel="stylesheet" href="/assets/css/workspace-theme.css"><link rel="stylesheet" href="/assets/css/app.css"></head>
<body><main class="login-shell"><section class="panel login-panel"><h1>Перший запуск UTEX ERP</h1><p class="subtitle">У базі ще немає робочого користувача. Створіть обліковий запис адміністратора.</p><% if (error) { %><div class="notice error"><%= error %></div><% } %><form method="post" action="/setup"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label for="username">Логін</label><input id="username" name="username" autocomplete="username" required></div><div class="field"><label for="password">Пароль (від 12 символів)</label><input id="password" name="password" type="password" minlength="12" autocomplete="new-password" required></div><div class="form-actions"><button class="button primary" type="submit">Створити адміністратора</button></div></form></section></main></body></html>
