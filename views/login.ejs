<!doctype html><html lang="uk"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/assets/css/workspace.css"><link rel="stylesheet" href="/assets/css/workspace-theme.css"><link rel="stylesheet" href="/assets/css/app.css"></head>
<body><main class="login-shell"><section class="panel login-panel"><a class="brand" href="/login"><img src="/assets/logo.png" alt="UTEX"><span>PRODUCTION / ERP</span></a><h1>Вхід у систему</h1><p class="subtitle">Увійдіть під робочим обліковим записом.</p><% if (error) { %><div class="notice error"><%= error %></div><% } %><form method="post" action="/login"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="next" value="<%= next %>"><div class="field"><label for="username">Логін</label><input id="username" name="username" autocomplete="username" required autofocus></div><div class="field"><label for="password">Пароль</label><input id="password" name="password" type="password" autocomplete="current-password" required></div><div class="form-actions"><button class="button primary" type="submit">Увійти</button></div></form></section></main></body></html>
